{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/next-step.schema.json",
  "title": "Next-step guidance (human or automatic action)",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "next_step_id",
    "source_refs",
    "next_actor_role",
    "action_type",
    "instructions",
    "target_paths",
    "approval_required",
    "auto_execution"
  ],
  "properties": {
    "artifact_version": {
      "const": "next-step/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "next_step_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "source_refs": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "artifact-common.schema.json#/$defs/opaqueId"
        },
        "result_id": {
          "$ref": "artifact-common.schema.json#/$defs/opaqueId"
        },
        "result_sha256": {
          "$ref": "artifact-common.schema.json#/$defs/sha256"
        },
        "event_id": {
          "$ref": "artifact-common.schema.json#/$defs/opaqueId"
        }
      },
      "additionalProperties": false
    },
    "completed_phase": {
      "type": "string"
    },
    "completed_procedure": {
      "type": "string"
    },
    "result_outcome": {
      "type": "string"
    },
    "next_phase": {
      "type": "string"
    },
    "next_procedure": {
      "type": "string"
    },
    "next_actor_role": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "artifact-common.schema.json#/$defs/roleId"
        }
      ]
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "$ref": "artifact-common.schema.json#/$defs/pathSha256"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "command_example": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_paths": {
      "type": "array",
      "items": {
        "$ref": "artifact-common.schema.json#/$defs/relativePath"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_execution": {
      "type": "boolean"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "auto_execution": {
            "const": true
          }
        },
        "required": [
          "auto_execution"
        ]
      },
      "then": {
        "properties": {
          "approval_required": {
            "const": false
          }
        }
      }
    }
  ],
  "x-artifact-migration": {
    "id_pattern": "^next-step/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
