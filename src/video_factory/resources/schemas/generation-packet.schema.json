{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/generation-packet.schema.json",
  "title": "Generation packet (provider-opaque prompts and plan)",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "generated_by",
    "approved_by_human",
    "shots"
  ],
  "properties": {
    "artifact_version": {
      "const": "generation-packet/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    },
    "generated_by": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "reviewed_by": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "approved_by_human": {
      "type": "boolean",
      "description": "Non-authoritative compatibility flag; authoritative approval is packet-approval"
    },
    "title_working": {
      "type": "string"
    },
    "reference_manifest": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "artifact-common.schema.json#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "artifact-common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "quota_plan": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "budgets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "additionalProperties": {
            "$ref": "artifact-common.schema.json#/$defs/quotaAmount"
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "dir",
        "filename_pattern"
      ],
      "properties": {
        "dir": {
          "$ref": "artifact-common.schema.json#/$defs/relativePath"
        },
        "filename_pattern": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "properties": {
            "aspect": {
              "type": "string",
              "minLength": 1
            },
            "min_height": {
              "type": "integer",
              "minimum": 1
            },
            "min_width": {
              "type": "integer",
              "minimum": 1
            },
            "fps_min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "audio_required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "targets_by_adapter": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "aspect": {
                "type": "string",
                "minLength": 1
              },
              "min_height": {
                "type": "integer",
                "minimum": 1
              },
              "min_width": {
                "type": "integer",
                "minimum": 1
              },
              "fps_min": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "audio_required": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "duration_sec",
          "candidates",
          "prompt"
        ],
        "properties": {
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration_tolerance_sec": {
            "type": "number",
            "minimum": 0
          },
          "candidates": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "first_frame_note": {
            "type": "string"
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_assets": {
            "type": "array",
            "items": {
              "$ref": "artifact-common.schema.json#/$defs/pathSha256"
            }
          },
          "provider_plans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "adapter_id",
                "candidates"
              ],
              "properties": {
                "adapter_id": {
                  "$ref": "artifact-common.schema.json#/$defs/opaqueId"
                },
                "capability_id": {
                  "$ref": "artifact-common.schema.json#/$defs/opaqueId"
                },
                "candidates": {
                  "type": "integer",
                  "minimum": 1
                },
                "params": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^generation-packet/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
