{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/director/director-synthesis.schema.json",
  "title": "Bounded deterministic Director synthesis",
  "type": "object",
  "required": [
    "artifact_version", "synthesis_id", "synthesis_sha256", "base_blueprint_sha256",
    "blueprint_context_sha256", "assessment_sha256s", "conflict_sha256s", "status",
    "resulting_blueprint_sha256", "unresolved_blockers", "rounds_used"
  ],
  "properties": {
    "artifact_version": { "const": "director-synthesis/1.0" },
    "synthesis_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "synthesis_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "base_blueprint_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "blueprint_context_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "assessment_sha256s": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "artifact-common.schema.json#/$defs/sha256" }
    },
    "conflict_sha256s": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "artifact-common.schema.json#/$defs/sha256" }
    },
    "status": { "type": "string", "enum": ["coherent", "blocked"] },
    "resulting_blueprint_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/sha256" }]
    },
    "unresolved_blockers": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCode" }
    },
    "rounds_used": { "type": "integer", "minimum": 1, "maximum": 2 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "coherent" } } },
      "then": {
        "properties": {
          "resulting_blueprint_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
          "unresolved_blockers": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "resulting_blueprint_sha256": { "type": "null" },
          "unresolved_blockers": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^director-synthesis/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
