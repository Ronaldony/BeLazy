{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/edit-manifest.schema.json",
  "title": "Human-selected edit manifest (prep only)",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "selected_by_human",
    "selected_by",
    "selected_at",
    "input_clips",
    "audio_required"
  ],
  "properties": {
    "artifact_version": {
      "const": "edit-manifest/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    },
    "selected_by_human": {
      "type": "boolean"
    },
    "selected_by": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "selected_at": {
      "type": "string",
      "minLength": 1
    },
    "input_clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "path",
          "sha256"
        ],
        "properties": {
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "path": {
            "$ref": "artifact-common.schema.json#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "artifact-common.schema.json#/$defs/sha256"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "target_platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "audio_required": {
      "type": "boolean"
    },
    "output_path": {
      "$ref": "artifact-common.schema.json#/$defs/relativePath"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^edit-manifest/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
