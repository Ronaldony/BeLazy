{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/runtime/publication-receipt.schema.json",
  "title": "Durable fixture publication receipt",
  "type": "object",
  "required": [
    "artifact_version", "receipt_id", "receipt_sha256",
    "publication_intent_sha256", "journal_id", "journal_head_sha256",
    "release_candidate", "release_assessment", "destination",
    "workspace_before_verifier_record", "workspace_after_verifier_record",
    "action_request_sha256", "authority_decision_sha256",
    "authority_receipt_sha256", "service_identity", "external_reference_id",
    "external_request_id", "external_session_id", "started_at", "completed_at",
    "status", "published", "measured_cost_minor_units", "currency",
    "settlement_record", "reconciliation_record", "reason_codes",
    "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "publication-receipt/1.0" },
    "receipt_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "receipt_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "publication_intent_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "journal_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "journal_head_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "release_candidate": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "release_assessment": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "destination": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "workspace_before_verifier_record": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "workspace_after_verifier_record": { "$ref": "#/$defs/nullableRef" },
    "action_request_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "authority_decision_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "authority_receipt_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "service_identity": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "external_reference_id": { "$ref": "#/$defs/nullableToken" },
    "external_request_id": { "$ref": "#/$defs/nullableString" },
    "external_session_id": { "$ref": "#/$defs/nullableString" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["succeeded", "failed", "uncertain", "reconciled"] },
    "published": { "type": ["boolean", "null"] },
    "measured_cost_minor_units": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "currency": { "$ref": "#/$defs/nullableString" },
    "settlement_record": { "$ref": "#/$defs/nullableRef" },
    "reconciliation_record": { "$ref": "#/$defs/nullableRef" },
    "reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "nullableRef": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" }] },
    "nullableToken": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/opaqueId" }] },
    "nullableString": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
  },
  "additionalProperties": false
}
