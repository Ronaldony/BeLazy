{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/quality/quality-bundle.schema.json",
  "title": "Exact-media independent W05 QualityBundle",
  "type": "object",
  "required": [
    "artifact_version", "bundle_id", "bundle_sha256", "episode_id",
    "policy_sha256", "gate_context", "evaluated_at", "evaluations",
    "subjects", "status", "hard_failure_reason_codes",
    "safety_failure_reason_codes", "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "quality-bundle/1.0" },
    "bundle_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "policy_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "gate_context": { "$ref": "artifact-common.schema.json#/$defs/gateContext" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "evaluations": {
      "type": "array", "minItems": 9, "uniqueItems": true,
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "subjects": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/summary" }
    },
    "status": { "$ref": "#/$defs/status" },
    "hard_failure_reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
    "safety_failure_reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "dimension": {
      "enum": [
        "technical_media", "visual_conformance", "cinematography",
        "motion_naturalness", "narrative_intent", "continuity", "audio",
        "edit_rhythm", "platform_compliance"
      ]
    },
    "verdict": { "enum": ["pass", "warn", "fail", "inconclusive"] },
    "status": { "enum": ["passed", "blocked", "inconclusive"] },
    "evaluation": {
      "type": "object",
      "required": [
        "evaluation_id", "evaluation_sha256", "dimension", "subject",
        "evaluator_id", "evaluator_version", "evaluator_receipt_ref",
        "policy_sha256", "gate_context_sha256", "verdict", "score_bps",
        "hard_failure", "safety_failure", "reason_codes", "evidence_refs"
      ],
      "properties": {
        "evaluation_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "evaluation_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "subject": { "$ref": "artifact-common.schema.json#/$defs/mediaSubject" },
        "evaluator_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "evaluator_version": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "evaluator_receipt_ref": {
          "allOf": [
            { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
            { "properties": { "artifact_version": { "const": "quality-evaluation-receipt/1.0" } } }
          ]
        },
        "policy_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "gate_context_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "score_bps": { "$ref": "artifact-common.schema.json#/$defs/basisPoints" },
        "hard_failure": { "type": "boolean" },
        "safety_failure": { "type": "boolean" },
        "reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
        "evidence_refs": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "subject", "status", "aggregate_score_bps", "failed_dimensions",
        "hard_failure_reason_codes", "safety_failure_reason_codes"
      ],
      "properties": {
        "subject": { "$ref": "artifact-common.schema.json#/$defs/mediaSubject" },
        "status": { "$ref": "#/$defs/status" },
        "aggregate_score_bps": { "$ref": "artifact-common.schema.json#/$defs/basisPoints" },
        "failed_dimensions": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "hard_failure_reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
        "safety_failure_reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
