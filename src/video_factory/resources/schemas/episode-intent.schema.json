{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/blueprint/episode-intent.schema.json",
  "title": "Episode design intent",
  "type": "object",
  "required": [
    "artifact_version", "intent_id", "intent_sha256", "episode_id",
    "channel_constitution_sha256", "concept_constitution_sha256",
    "needs_complexity", "activation_signals", "fields"
  ],
  "properties": {
    "artifact_version": { "const": "episode-intent/1.0" },
    "intent_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "intent_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "channel_constitution_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "concept_constitution_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "needs_complexity": { "type": "string", "enum": ["LIGHT", "PRODUCTION", "COMPLEX"] },
    "activation_signals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" }
    },
    "fields": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "artifact-common.schema.json#/$defs/blueprintField" }
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^episode-intent/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
