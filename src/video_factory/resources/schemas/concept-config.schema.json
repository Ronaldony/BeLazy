{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/config/concept-config.schema.json",
  "title": "Concept configuration",
  "type": "object",
  "required": ["artifact_version", "config_contract", "concept_id"],
  "properties": {
    "artifact_version": {"const": "concept-config/1.0"},
    "config_contract": {"const": "1.0"},
    "concept_id": {"$ref": "config-layer.schema.json#/$defs/opaqueId"},
    "settings": {"$ref": "config-layer.schema.json#/$defs/settings"},
    "extensions": {"$ref": "config-layer.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^concept-config/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
