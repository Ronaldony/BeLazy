{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/storyboard-approval.schema.json",
  "title": "Storyboard human approval (hash-bound)",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "approved_by_human",
    "approver_role",
    "approved_at",
    "bound_artifacts"
  ],
  "properties": {
    "artifact_version": { "const": "storyboard-approval/1.0" },
    "rules_version": { "$ref": "artifact-common.schema.json#/$defs/rulesVersion" },
    "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "approved_by_human": { "type": "boolean" },
    "approver_role": { "$ref": "artifact-common.schema.json#/$defs/roleId" },
    "approved_at": { "type": "string", "minLength": 1 },
    "bound_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" }
    },
    "effective_config_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "notes": { "type": "string" },
    "extensions": { "$ref": "artifact-common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^storyboard-approval/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
