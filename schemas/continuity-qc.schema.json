{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/continuity-qc.schema.json",
  "title": "Cross-shot continuity QC report over generated clips",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "checked_at",
    "subjects",
    "observations",
    "comparisons",
    "measurements",
    "judgments",
    "verdict"
  ],
  "properties": {
    "artifact_version": {
      "const": "continuity-qc/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "description": "Generated shot outputs compared against each other.",
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "artifact"
        ],
        "properties": {
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "artifact": {
            "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
          }
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "description": "Measurements the caller took. Core never measures.",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "shot_id",
          "element_id",
          "axis",
          "sample_point"
        ],
        "properties": {
          "observation_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "element_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "axis": {
            "type": "string",
            "enum": [
              "relative_scale",
              "orientation_shape",
              "presence"
            ]
          },
          "sample_point": {
            "type": "string",
            "enum": [
              "first",
              "middle",
              "last"
            ]
          },
          "measure_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "measure_argv_hint": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_measure_methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "method",
                "argv_hint"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "argv_hint": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "comparison_id",
          "element_id",
          "axis",
          "from_observation_id",
          "to_observation_id",
          "severity"
        ],
        "properties": {
          "comparison_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "element_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "axis": {
            "type": "string",
            "enum": [
              "relative_scale",
              "orientation_shape",
              "presence"
            ]
          },
          "from_observation_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "to_observation_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "tolerance": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
            "description": "Owner-supplied numeric tolerance as an exact decimal string. Core holds no default."
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "measurements": {
      "type": "array",
      "description": "Closed measurement evidence used to compute the judgments.",
      "items": {
        "$ref": "artifact-common.schema.json#/$defs/measurement"
      }
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "comparison_id",
          "status",
          "message"
        ],
        "properties": {
          "comparison_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "inconclusive",
              "not_applicable"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail",
        "inconclusive"
      ]
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
