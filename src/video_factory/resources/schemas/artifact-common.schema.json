{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/artifact-common.schema.json",
  "title": "Shared artifact document definitions",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "rulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gateContext": {
      "type": "object",
      "required": [
        "workflow_definition_sha256",
        "policy_bundle_sha256",
        "rules_bundle_sha256",
        "effective_config_sha256",
        "current_manifest_sha256",
        "evidence_graph_sha256",
        "executable_plan_sha256"
      ],
      "properties": {
        "workflow_definition_sha256": { "$ref": "#/$defs/sha256" },
        "policy_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "rules_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "effective_config_sha256": { "$ref": "#/$defs/sha256" },
        "current_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_graph_sha256": { "$ref": "#/$defs/sha256" },
        "executable_plan_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
    },
    "artifactVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\/[1-9][0-9]*\\.[0-9]+$"
    },
    "roleId": {
      "type": "string",
      "minLength": 1
    },
    "reviewVerdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "uncertain"
      ]
    },
    "extension": {
      "type": "object",
      "required": [
        "contract_version",
        "payload"
      ],
      "properties": {
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      },
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$": {
          "$ref": "#/$defs/extension"
        }
      },
      "additionalProperties": false
    },
    "boundArtifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "artifact_version"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_version": {
          "$ref": "#/$defs/artifactVersion"
        }
      },
      "additionalProperties": false
    },
    "blueprintFieldPath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$"
    },
    "canonicalReasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "blueprintField": {
      "type": "object",
      "required": ["path", "value_json"],
      "properties": {
        "path": { "$ref": "#/$defs/blueprintFieldPath" },
        "value_json": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "blueprintContext": {
      "type": "object",
      "required": [
        "channel_constitution_sha256",
        "concept_constitution_sha256",
        "episode_intent_sha256",
        "policy_bundle_sha256",
        "rules_bundle_sha256",
        "effective_config_sha256",
        "current_manifest_sha256",
        "evidence_graph_sha256"
      ],
      "properties": {
        "channel_constitution_sha256": { "$ref": "#/$defs/sha256" },
        "concept_constitution_sha256": { "$ref": "#/$defs/sha256" },
        "episode_intent_sha256": { "$ref": "#/$defs/sha256" },
        "policy_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "rules_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "effective_config_sha256": { "$ref": "#/$defs/sha256" },
        "current_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_graph_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "directorScopePattern": {
      "type": "string",
      "pattern": "^(?:\\*|[a-z][a-z0-9_-]*)(?:\\.(?:\\*|[a-z0-9][a-z0-9_-]*))*$"
    },
    "marketingReason": {
      "type": "object",
      "required": [
        "reason_id",
        "statement"
      ],
      "properties": {
        "reason_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "code",
        "message",
        "path"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "pathSha256": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "adapterOutcome": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "REJECTED",
        "FAILED",
        "EXTERNAL_UNCERTAIN",
        "AWAITING_HUMAN"
      ]
    },
    "quotaAmount": {
      "type": "object",
      "required": [
        "unit",
        "amount"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "measurement_id",
        "value"
      ],
      "properties": {
        "measurement_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "string",
      "enum": [
        "equal",
        "minimum",
        "maximum",
        "range",
        "member_of"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "qcConstraint": {
      "type": "object",
      "required": [
        "constraint_id",
        "measurement_id",
        "comparison",
        "operands",
        "severity"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "measurement_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "operands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "number",
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "severity": {
          "$ref": "#/$defs/severity"
        }
      },
      "additionalProperties": false
    },
    "qcFinding": {
      "type": "object",
      "required": [
        "constraint_id",
        "passed",
        "observed",
        "message"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "passed": {
          "type": "boolean"
        },
        "observed": {
          "$ref": "#/$defs/measurement"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "externalReference": {
      "type": "object",
      "required": [
        "request_id",
        "session_id"
      ],
      "properties": {
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "measuredCost": {
      "type": "object",
      "required": [
        "amount",
        "unit",
        "is_unknown"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_unknown": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "uncertaintyEvidence": {
      "type": "object",
      "required": [
        "uncertain"
      ],
      "properties": {
        "uncertain": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reconcile_evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/boundArtifact"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "managedRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*[:*?\\\"<>|\\u0000-\\u001f\\u007f])(?!.*(?:^|/)[^/]*[ .](?:/|$)).+$"
    },
    "mutationKind": {
      "type": "string",
      "enum": ["create", "replace", "delete", "move"]
    },
    "mutationRiskTier": {
      "type": "string",
      "enum": ["R1", "R2", "R3", "R4"]
    },
    "contentObject": {
      "type": "object",
      "required": ["object_id", "exact_sha256", "byte_length"],
      "properties": {
        "object_id": { "$ref": "#/$defs/opaqueId" },
        "exact_sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "expectedBefore": {
      "type": "object",
      "required": ["exists", "exact_sha256"],
      "properties": {
        "exists": { "type": "boolean" },
        "exact_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "exists": { "const": true } } },
          "then": { "properties": { "exact_sha256": { "$ref": "#/$defs/sha256" } } },
          "else": { "properties": { "exact_sha256": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "mutationIntent": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "destination_path",
        "expected_before",
        "new_content"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/mutationKind" },
        "path": { "$ref": "#/$defs/managedRelativePath" },
        "destination_path": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/managedRelativePath" }
          ]
        },
        "expected_before": { "$ref": "#/$defs/expectedBefore" },
        "new_content": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/contentObject" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "create" } } },
          "then": {
            "properties": {
              "destination_path": { "type": "null" },
              "expected_before": {
                "properties": { "exists": { "const": false } }
              },
              "new_content": { "$ref": "#/$defs/contentObject" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "replace" } } },
          "then": {
            "properties": {
              "destination_path": { "type": "null" },
              "expected_before": {
                "properties": { "exists": { "const": true } }
              },
              "new_content": { "$ref": "#/$defs/contentObject" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "delete" } } },
          "then": {
            "properties": {
              "destination_path": { "type": "null" },
              "expected_before": {
                "properties": { "exists": { "const": true } }
              },
              "new_content": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "move" } } },
          "then": {
            "properties": {
              "destination_path": { "$ref": "#/$defs/managedRelativePath" },
              "expected_before": {
                "properties": { "exists": { "const": true } }
              },
              "new_content": { "type": "null" }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
