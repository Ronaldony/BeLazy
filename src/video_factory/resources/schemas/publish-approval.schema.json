{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/publish-approval.schema.json",
  "title": "Publish approval evidence",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "requirement_id",
    "capability_id",
    "evidence_id",
    "state",
    "approved_by_human",
    "approver_role",
    "approved_at",
    "record_sha256",
    "bound_artifacts",
    "effective_config_sha256"
  ],
  "properties": {
    "artifact_version": {
      "const": "publish-approval/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "requirement_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "capability_id": {
      "const": "publish_approval"
    },
    "evidence_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "state": {
      "const": "granted"
    },
    "approved_by_human": {
      "const": true
    },
    "approver_role": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_sha256": {
      "$ref": "artifact-common.schema.json#/$defs/sha256"
    },
    "bound_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
      }
    },
    "effective_config_sha256": {
      "$ref": "artifact-common.schema.json#/$defs/sha256"
    },
    "gate_context": {
      "$ref": "artifact-common.schema.json#/$defs/gateContext"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    }
  },
  "dependentRequired": {
    "gate_context": ["expires_at"],
    "expires_at": ["gate_context"]
  },
  "additionalProperties": false
}
