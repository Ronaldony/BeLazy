{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/config/config-layer.schema.json",
  "title": "Shared closed configuration definitions",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "aspectRatio": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "aspect_ratio": {"$ref": "#/$defs/aspectRatio"},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["recurring_character_ids"],
      "properties": {
        "recurring_character_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaqueId"}
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"$ref": "#/$defs/opaqueId"}
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "media": {"$ref": "#/$defs/media"},
        "identity": {"$ref": "#/$defs/identity"},
        "execution": {"$ref": "#/$defs/execution"}
      },
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "required": ["contract_version", "payload"],
      "properties": {
        "contract_version": {"$ref": "#/$defs/contractVersion"},
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      },
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$": {
          "$ref": "#/$defs/extension"
        }
      },
      "additionalProperties": false
    },
    "effective": {
      "type": "object",
      "required": ["settings", "extensions"],
      "properties": {
        "settings": {"$ref": "#/$defs/settings"},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
