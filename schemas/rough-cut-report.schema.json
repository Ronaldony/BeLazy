{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/rough-cut-report.schema.json",
  "title": "Rough-cut assembly report (local tools only)",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "checked_at",
    "status",
    "ranking_ref",
    "inputs",
    "output_path"
  ],
  "properties": {
    "artifact_version": {
      "const": "rough-cut-report/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    },
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "ranking_ref": {
      "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
    },
    "storyboard_ref": {
      "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "path",
          "sha256",
          "duration_sec"
        ],
        "properties": {
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "path": {
            "$ref": "artifact-common.schema.json#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "artifact-common.schema.json#/$defs/sha256"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "output_path": {
      "$ref": "artifact-common.schema.json#/$defs/relativePath"
    },
    "local_tools": {
      "type": "object",
      "properties": {
        "encoder_available": {
          "type": "boolean"
        },
        "probe_available": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qc": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^rough-cut-report/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
