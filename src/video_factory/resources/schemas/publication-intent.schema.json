{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/runtime/publication-intent.schema.json",
  "title": "Non-authorizing publication execution intent",
  "type": "object",
  "required": [
    "artifact_version", "intent_id", "intent_sha256", "request_id",
    "idempotency_key", "release_candidate", "release_candidate_sha256",
    "release_assessment", "release_assessment_sha256", "destination",
    "destination_sha256", "workspace_id", "channel_id", "concept_id",
    "episode_id", "gate_context_sha256", "workspace_observation_sha256",
    "publisher_id", "publisher_variant_id", "destination_id",
    "cost_minor_units", "currency", "retry_index", "created_at",
    "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "publication-intent/1.0" },
    "intent_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "intent_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "request_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "idempotency_key": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "release_candidate": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "release_candidate_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "release_assessment": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "release_assessment_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "destination": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "destination_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "workspace_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "channel_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "concept_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "gate_context_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "workspace_observation_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "publisher_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "publisher_variant_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "destination_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "cost_minor_units": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "minLength": 1 },
    "retry_index": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "authority_effect": { "const": "none" }
  },
  "additionalProperties": false
}
