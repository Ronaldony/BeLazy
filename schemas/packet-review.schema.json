{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/packet-review.schema.json",
  "title": "Generation packet cross-review result",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "subject",
    "creator_role",
    "reviewer_role",
    "reviewed_at",
    "verdict",
    "findings"
  ],
  "properties": {
    "artifact_version": {
      "const": "packet-review/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    },
    "subject": {
      "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
    },
    "creator_role": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "reviewer_role": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "$ref": "artifact-common.schema.json#/$defs/reviewVerdict"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "artifact-common.schema.json#/$defs/finding"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^packet-review/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
