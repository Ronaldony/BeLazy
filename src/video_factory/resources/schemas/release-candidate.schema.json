{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/release/release-candidate.schema.json",
  "title": "Exact non-authorizing W05 release candidate",
  "type": "object",
  "required": [
    "artifact_version", "candidate_id", "candidate_sha256", "workspace_id",
    "channel_id", "concept_id", "episode_id",
    "final_media", "metadata_ref", "subtitle_accessibility_refs",
    "thumbnail", "quality_bundle_ref", "quality_bundle_sha256",
    "candidate_decision_ref", "candidate_decision_sha256", "destination_ref",
    "destination_sha256", "policy_sha256", "gate_context",
    "workspace_observation_sha256", "release_intent_sha256", "created_at",
    "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "release-candidate/1.0" },
    "candidate_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "candidate_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "workspace_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "channel_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "concept_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "final_media": { "$ref": "artifact-common.schema.json#/$defs/mediaSubject" },
    "metadata_ref": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "subtitle_accessibility_refs": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" }
    },
    "thumbnail": { "$ref": "artifact-common.schema.json#/$defs/mediaSubject" },
    "quality_bundle_ref": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "quality_bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "candidate_decision_ref": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "candidate_decision_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "destination_ref": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "destination_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "policy_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "gate_context": { "$ref": "artifact-common.schema.json#/$defs/gateContext" },
    "workspace_observation_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "release_intent_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" },
    "authority_effect": { "const": "none" }
  },
  "additionalProperties": false
}
