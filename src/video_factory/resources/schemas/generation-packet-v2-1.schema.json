{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/generation-packet-v2-1.schema.json",
  "title": "Generation packet with feasibility inputs and declared cross-shot state carryover",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "generated_by",
    "approved_by_human",
    "storyboard_ref",
    "output",
    "shots"
  ],
  "properties": {
    "artifact_version": {
      "const": "generation-packet/2.1"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "generated_by": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "approved_by_human": {
      "type": "boolean",
      "description": "Compatibility display flag only. It never grants generation authority."
    },
    "storyboard_ref": {
      "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
    },
    "title_working": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "dir",
        "filename_pattern",
        "target"
      ],
      "properties": {
        "dir": {
          "$ref": "artifact-common.schema.json#/$defs/relativePath"
        },
        "filename_pattern": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps_min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "audio_required": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "source_shot_id",
          "duration_sec",
          "candidates",
          "capability_id",
          "prompt",
          "first_frame",
          "continuity",
          "render_dependencies"
        ],
        "properties": {
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "source_shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration_tolerance_sec": {
            "type": "number",
            "minimum": 0
          },
          "candidates": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "first_frame": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "width",
              "height",
              "state",
              "depicted_elements"
            ],
            "properties": {
              "path": {
                "$ref": "artifact-common.schema.json#/$defs/relativePath"
              },
              "sha256": {
                "$ref": "artifact-common.schema.json#/$defs/sha256"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "before",
                  "after",
                  "uncertain"
                ]
              },
              "depicted_elements": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "artifact-common.schema.json#/$defs/opaqueId"
                },
                "description": "Opaque element ids depicted in this first frame. Owner vocabulary; core assigns none."
              }
            },
            "additionalProperties": false
          },
          "continuity": {
            "type": "object",
            "required": [
              "required",
              "carried_elements"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "group_id": {
                "$ref": "artifact-common.schema.json#/$defs/opaqueId"
              },
              "master_plate_ref": {
                "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
              },
              "carried_elements": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "element_id",
                    "from_shot_id"
                  ],
                  "properties": {
                    "element_id": {
                      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
                    },
                    "from_shot_id": {
                      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "State this first frame must inherit from an earlier shot. Completeness is checked against the hash-bound storyboard source shot's end_state_elements; an empty array passes only when that evidence declares an empty expected set."
              }
            },
            "additionalProperties": false
          },
          "render_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feature_id",
                "handled_in"
              ],
              "properties": {
                "feature_id": {
                  "$ref": "artifact-common.schema.json#/$defs/opaqueId"
                },
                "handled_in": {
                  "type": "string",
                  "enum": [
                    "generation",
                    "edit",
                    "not_required"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^generation-packet/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
