{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/selection/candidate-decision.schema.json",
  "title": "Confidence-bound non-authorizing W05 candidate decision",
  "type": "object",
  "required": [
    "artifact_version", "decision_id", "decision_sha256", "episode_id",
    "quality_bundle_ref", "quality_bundle_sha256", "policy_sha256",
    "gate_context", "evaluated_at", "selection_input_sha256",
    "authority_request_sha256", "authority_decision_sha256",
    "authority_receipt_sha256", "shots", "status", "reason_codes",
    "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "candidate-decision/1.0" },
    "decision_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "decision_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "quality_bundle_ref": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "quality_bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "policy_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "gate_context": { "$ref": "artifact-common.schema.json#/$defs/gateContext" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "selection_input_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "authority_request_sha256": { "$ref": "#/$defs/nullableSha" },
    "authority_decision_sha256": { "$ref": "#/$defs/nullableSha" },
    "authority_receipt_sha256": { "$ref": "#/$defs/nullableSha" },
    "shots": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/shot" }
    },
    "status": { "$ref": "#/$defs/status" },
    "reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "nullableSha": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "artifact-common.schema.json#/$defs/sha256" }
      ]
    },
    "status": { "enum": ["auto_selected", "escalation_required", "denied"] },
    "ranked": {
      "type": "object",
      "required": ["subject", "adapter_id", "quality_score_bps", "confidence_bps", "confidence_receipt_ref"],
      "properties": {
        "subject": { "$ref": "artifact-common.schema.json#/$defs/mediaSubject" },
        "adapter_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "quality_score_bps": { "$ref": "artifact-common.schema.json#/$defs/basisPoints" },
        "confidence_bps": { "$ref": "artifact-common.schema.json#/$defs/basisPoints" },
        "confidence_receipt_ref": {
          "allOf": [
            { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
            { "properties": { "artifact_version": { "const": "candidate-confidence-receipt/1.0" } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "required": [
        "shot_id", "status", "ranked_candidates", "selected_subject",
        "margin_to_second_bps", "reason_codes"
      ],
      "properties": {
        "shot_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "status": { "$ref": "#/$defs/status" },
        "ranked_candidates": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/ranked" }
        },
        "selected_subject": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "artifact-common.schema.json#/$defs/mediaSubject" }
          ]
        },
        "margin_to_second_bps": { "$ref": "artifact-common.schema.json#/$defs/basisPoints" },
        "reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
