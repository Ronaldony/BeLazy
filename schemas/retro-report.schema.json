{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/retro-report.schema.json",
  "title": "Deterministic retro evaluation report (policy-injected rules)",
  "type": "object",
  "required": [
    "artifact_version",
    "episode_id",
    "policy_id",
    "checkpoint_window_ids",
    "evaluations",
    "counts"
  ],
  "properties": {
    "artifact_version": {
      "const": "retro-report/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "policy_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    },
    "checkpoint_window_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "artifact-common.schema.json#/$defs/opaqueId"
      },
      "description": "Window ids from the records used in evaluation (data-injected, not core vocabulary)"
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "hypothesis_id",
          "metric_key",
          "comparator",
          "threshold",
          "observed_value",
          "verdict",
          "evidence"
        ],
        "properties": {
          "rule_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "hypothesis_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId",
            "description": "Opaque hypothesis id; core does not interpret marketing taxonomies"
          },
          "metric_key": {
            "type": "string",
            "minLength": 1
          },
          "comparator": {
            "type": "string",
            "enum": [
              "gte",
              "lte",
              "gt",
              "lt",
              "eq",
              "between"
            ]
          },
          "threshold": {
            "description": "Single number or inclusive {min,max} range for between",
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "required": [
                  "min",
                  "max"
                ],
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "observed_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "refuted",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "source_window_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "source_collected_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "supported",
        "refuted",
        "inconclusive"
      ],
      "properties": {
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "refuted": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
