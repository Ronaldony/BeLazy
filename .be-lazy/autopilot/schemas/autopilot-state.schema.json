{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://be-lazy.local/schemas/autopilot-state.schema.json",
  "title": "be-lazy Autopilot State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "program_id",
    "status",
    "source",
    "handoff",
    "target",
    "waves",
    "updated_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "be-lazy-prompt-autopilot-state/1.0"
    },
    "program_id": {
      "const": "be-lazy-successor-redesign"
    },
    "status": {
      "enum": [
        "initializing",
        "running",
        "reviewing",
        "repairing",
        "complete",
        "partial",
        "blocked"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_or_attachment",
        "expected_sha256",
        "observed_sha256",
        "unchanged"
      ],
      "properties": {
        "path_or_attachment": {
          "type": "string",
          "minLength": 1
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unchanged": {
          "type": "boolean"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_or_attachment",
        "manifest_sha256",
        "verified"
      ],
      "properties": {
        "path_or_attachment": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "branch",
        "initial_commit",
        "current_head",
        "working_tree_clean"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "const": "agent/autopilot-v4"
        },
        "initial_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "working_tree_clean": {
          "type": "boolean"
        }
      }
    },
    "waves": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "attempts",
          "task_ids",
          "checkpoint_commit",
          "tests",
          "reviews",
          "unresolved_findings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^W0[0-7]-"
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "reviewing",
              "repairing",
              "passed",
              "blocked"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "checkpoint_commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status", "result"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "status": {"type": "string", "minLength": 1},
                "result": {"type": "string", "minLength": 1}
              }
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["round", "role", "status"],
              "properties": {
                "round": {"type": "integer", "minimum": 1},
                "role": {"type": "string", "minLength": 1},
                "status": {"type": "string", "minLength": 1},
                "critical": {"type": "integer", "minimum": 0},
                "high": {"type": "integer", "minimum": 0}
              }
            }
          },
          "unresolved_findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "passed"}},
              "required": ["status"]
            },
            "then": {
              "properties": {
                "attempts": {"minimum": 1},
                "checkpoint_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "tests": {"minItems": 1},
                "reviews": {"minItems": 3},
                "unresolved_findings": {"maxItems": 0}
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {"const": "W00-BOOTSTRAP-BASELINE"},
              "task_ids": {"const": ["BOOT-001", "BOOT-002", "BOOT-003", "BOOT-004", "BOOT-005"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {"const": "W01-TRUST-BOUNDARY"},
              "task_ids": {"const": ["P0-PKG-001", "P0-JSON-001", "P0-AUTH-001"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {"const": "W02-MANAGED-MUTATION"},
              "task_ids": {"const": ["MUT-001", "MUT-002", "MUT-003", "MUT-004"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {"const": "W03-DIRECTOR-BLUEPRINT"},
              "task_ids": {"const": ["BP-001", "DIR-001", "DIR-002", "BP-002"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {"const": "W04-WORKFLOW-AUTHORITY"},
              "task_ids": {"const": ["WF-001", "AUTH-001", "AUTH-002", "WF-002"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {"const": "W05-AUTOMATION-QUALITY-RELEASE"},
              "task_ids": {"const": ["SEL-001", "QA-001", "REL-001"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {"const": "W06-RUNTIME-MIGRATION"},
              "task_ids": {"const": ["RUN-001", "RUN-002", "MIG-001", "REL-002"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {"const": "W07-FINAL-AUDIT"},
              "task_ids": {"const": ["AUDIT-001", "AUDIT-002", "AUDIT-003"]}
            },
            "required": ["id", "task_ids"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "non_blocking_gaps": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "hard_blocker": {
      "type": [
        "object",
        "null"
      ],
      "default": null
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
