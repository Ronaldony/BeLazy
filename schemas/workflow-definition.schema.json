{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/workflow/workflow-definition.schema.json",
  "title": "Versioned declarative production workflow",
  "type": "object",
  "required": ["artifact_version", "workflow_id", "workflow_version", "definition_sha256", "claims", "gates", "actions"],
  "properties": {
    "artifact_version": { "const": "workflow-definition/1.0" },
    "workflow_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "workflow_version": { "const": "episode-production-workflow/1.0" },
    "definition_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "dependency_claim_ids", "gate_id"],
        "properties": {
          "claim_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
          "dependency_claim_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
          "gate_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "owner", "stable_reason_prefix", "consumed_context_fields"],
        "properties": {
          "gate_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
          "owner": { "type": "string", "minLength": 1 },
          "stable_reason_prefix": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCode" },
          "consumed_context_fields": {
            "type": "array", "uniqueItems": true,
            "items": { "enum": ["workflow_definition_sha256", "policy_bundle_sha256", "rules_bundle_sha256", "effective_config_sha256", "current_manifest_sha256", "evidence_graph_sha256"] }
          }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id", "satisfies_claim_id", "required_claim_ids", "actor_role",
          "capability_id", "risk", "authority_requirement", "priority", "side_effect",
          "trigger_reason_codes", "prohibited_actions"
        ],
        "properties": {
          "action_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
          "satisfies_claim_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
          "required_claim_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
          "actor_role": { "$ref": "artifact-common.schema.json#/$defs/roleId" },
          "capability_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
          "risk": { "$ref": "workflow-authority-common.schema.json#/$defs/risk" },
          "authority_requirement": { "$ref": "workflow-authority-common.schema.json#/$defs/authorityRequirement" },
          "priority": { "type": "integer", "minimum": 0 },
          "side_effect": { "type": "boolean" },
          "trigger_reason_codes": { "$ref": "workflow-authority-common.schema.json#/$defs/reasonCodes" },
          "prohibited_actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
