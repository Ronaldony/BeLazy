{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/generation-feasibility-review.schema.json",
  "title": "Generation feasibility review",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "subject",
    "storyboard_ref",
    "capability_profile",
    "creator_role",
    "reviewer_role",
    "reviewed_at",
    "checks",
    "verdict"
  ],
  "properties": {
    "artifact_version": {
      "const": "generation-feasibility-review/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "subject": {
      "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
    },
    "storyboard_ref": {
      "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
    },
    "capability_profile": {
      "type": "object",
      "required": [
        "profile_id",
        "sha256",
        "capability_id"
      ],
      "properties": {
        "profile_id": {
          "$ref": "artifact-common.schema.json#/$defs/opaqueId"
        },
        "sha256": {
          "$ref": "artifact-common.schema.json#/$defs/sha256"
        },
        "capability_id": {
          "$ref": "artifact-common.schema.json#/$defs/opaqueId"
        }
      },
      "additionalProperties": false
    },
    "creator_role": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "reviewer_role": {
      "$ref": "artifact-common.schema.json#/$defs/roleId"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "kind",
          "shot_id",
          "status",
          "message"
        ],
        "properties": {
          "check_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "capability_binding",
              "minimum_duration",
              "first_frame_aspect",
              "first_frame_before_state",
              "continuity_anchor",
              "first_frame_state_carryover",
              "unsupported_render_dependency"
            ]
          },
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ]
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
