{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/runtime/projection-parity-receipt.schema.json",
  "title": "Trusted exact-pair projection parity receipt",
  "type": "object",
  "required": [
    "artifact_version", "receipt_id", "receipt_sha256", "consumer_id",
    "view_kind", "legacy_artifact", "projection_artifact",
    "source_blueprint_sha256", "projection_sha256",
    "legacy_normalized_sha256", "projection_normalized_sha256",
    "normalizer_id", "normalizer_version", "normalizer_sha256",
    "verifier_record", "policy_bundle_sha256", "evaluated_at", "parity_pass",
    "difference_count", "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "projection-parity-receipt/1.0" },
    "receipt_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "receipt_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "consumer_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "view_kind": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "legacy_artifact": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "projection_artifact": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "source_blueprint_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "projection_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "legacy_normalized_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "projection_normalized_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "normalizer_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "normalizer_version": { "type": "string", "minLength": 1 },
    "normalizer_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "verifier_record": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "policy_bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "parity_pass": { "type": "boolean" },
    "difference_count": { "type": "integer", "minimum": 0 },
    "authority_effect": { "const": "none" }
  },
  "additionalProperties": false
}
