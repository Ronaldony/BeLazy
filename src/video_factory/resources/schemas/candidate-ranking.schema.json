{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/candidate-ranking.schema.json",
  "title": "Deterministic candidate ranking (sort only; no auto selection)",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "generated_at",
    "packet_ref",
    "ranking_policy",
    "shots"
  ],
  "properties": {
    "artifact_version": {
      "const": "candidate-ranking/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "packet_ref": {
      "$ref": "artifact-common.schema.json#/$defs/boundArtifact"
    },
    "ranking_policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "candidates"
        ],
        "properties": {
          "shot_id": {
            "$ref": "artifact-common.schema.json#/$defs/opaqueId"
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "rank",
                "file",
                "adapter_id",
                "qc_ref",
                "media_sha256",
                "metrics"
              ],
              "properties": {
                "rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "file": {
                  "$ref": "artifact-common.schema.json#/$defs/relativePath"
                },
                "adapter_id": {
                  "$ref": "artifact-common.schema.json#/$defs/opaqueId"
                },
                "qc_ref": {
                  "$ref": "artifact-common.schema.json#/$defs/pathSha256"
                },
                "media_sha256": {
                  "$ref": "artifact-common.schema.json#/$defs/sha256"
                },
                "metrics": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": [
                      "number",
                      "string",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "rough_cut_candidate": {
                  "type": "boolean"
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^candidate-ranking/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
