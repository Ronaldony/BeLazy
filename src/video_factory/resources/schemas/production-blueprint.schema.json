{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/blueprint/production-blueprint.schema.json",
  "title": "Detailed single source of truth for production design",
  "type": "object",
  "required": [
    "artifact_version", "blueprint_id", "blueprint_sha256", "episode_id",
    "revision", "status", "context", "fields", "ownership",
    "director_provenance", "unresolved_blockers"
  ],
  "properties": {
    "artifact_version": { "const": "production-blueprint/1.0" },
    "blueprint_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "blueprint_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "coherent", "blocked"] },
    "context": { "$ref": "artifact-common.schema.json#/$defs/blueprintContext" },
    "fields": {
      "type": "array",
      "minItems": 40,
      "items": { "$ref": "artifact-common.schema.json#/$defs/blueprintField" }
    },
    "ownership": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "required": ["field_path", "owner_director_id", "verifier_director_ids"],
        "properties": {
          "field_path": { "$ref": "artifact-common.schema.json#/$defs/blueprintFieldPath" },
          "owner_director_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
          "verifier_director_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" }
          }
        },
        "additionalProperties": false
      }
    },
    "director_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "director_id", "director_version", "charter_sha256", "assessment_sha256",
          "input_blueprint_sha256", "blueprint_context_sha256"
        ],
        "properties": {
          "director_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
          "director_version": { "type": "string", "minLength": 1 },
          "charter_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
          "assessment_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
          "input_blueprint_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
          "blueprint_context_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "unresolved_blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCode" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "coherent" } } },
      "then": {
        "properties": {
          "unresolved_blockers": { "maxItems": 0 },
          "director_provenance": { "minItems": 1 },
          "fields": {
            "items": {
              "allOf": [
                { "$ref": "artifact-common.schema.json#/$defs/blueprintField" },
                {
                  "properties": {
                    "value_json": {
                      "not": { "enum": ["null", "\"\"", "[]", "{}"] }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "properties": { "unresolved_blockers": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^production-blueprint/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
