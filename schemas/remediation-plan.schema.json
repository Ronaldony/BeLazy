{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/quality/remediation-plan.schema.json",
  "title": "Bounded affected-target-only remediation plan",
  "type": "object",
  "required": [
    "artifact_version", "plan_id", "plan_sha256", "quality_bundle_sha256",
    "policy_sha256", "gate_context", "attempt_index",
    "predecessor_receipt_ref", "target_set_sha256",
    "cumulative_cost_minor_units", "candidate_count", "status", "targets",
    "history", "reason_codes", "full_pipeline_rerun", "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "remediation-plan/1.0" },
    "plan_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "plan_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "quality_bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "policy_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "gate_context": { "$ref": "artifact-common.schema.json#/$defs/gateContext" },
    "attempt_index": { "type": "integer", "minimum": 0 },
    "predecessor_receipt_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" }
      ]
    },
    "target_set_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "cumulative_cost_minor_units": { "type": "integer", "minimum": 0 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["not_required", "ready", "escalation_required"] },
    "targets": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "history": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/history" }
    },
    "reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
    "full_pipeline_rerun": { "const": false },
    "authority_effect": { "const": "none" }
  },
  "$defs": {
    "dimension": {
      "enum": [
        "technical_media", "visual_conformance", "cinematography",
        "motion_naturalness", "narrative_intent", "continuity", "audio",
        "edit_rhythm", "platform_compliance"
      ]
    },
    "target": {
      "type": "object",
      "required": ["subject", "component_id", "dimensions", "reason_codes", "retry_index"],
      "properties": {
        "subject": { "$ref": "artifact-common.schema.json#/$defs/mediaSubject" },
        "component_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "dimensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "reason_codes": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCodes" },
        "retry_index": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": [
        "attempt_index", "quality_bundle_sha256", "failed_target_sha256",
        "aggregate_score_bps", "attempt_receipt_ref",
        "cumulative_cost_minor_units", "candidate_count"
      ],
      "properties": {
        "attempt_index": { "type": "integer", "minimum": 0 },
        "quality_bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "failed_target_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "aggregate_score_bps": { "$ref": "artifact-common.schema.json#/$defs/basisPoints" },
        "attempt_receipt_ref": {
          "allOf": [
            { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
            { "properties": { "artifact_version": { "const": "remediation-attempt-receipt/1.0" } } }
          ]
        },
        "cumulative_cost_minor_units": { "type": "integer", "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
