{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/workflow/workflow-authority-common.schema.json",
  "title": "Shared declarative workflow and authority definitions",
  "$defs": {
    "materialContext": {
      "type": "object",
      "required": [
        "workflow_definition_sha256", "policy_bundle_sha256",
        "rules_bundle_sha256", "effective_config_sha256",
        "current_manifest_sha256", "evidence_graph_sha256"
      ],
      "properties": {
        "workflow_definition_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "policy_bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "rules_bundle_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "effective_config_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "current_manifest_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "evidence_graph_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "risk": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "assurance": { "enum": ["draft", "production", "high_assurance"] },
    "autonomy": { "enum": ["observe_only", "assisted", "guarded_autonomous", "bounded_autonomous"] },
    "authorityRequirement": {
      "enum": [
        "policy", "standing_or_one_human", "human_or_campaign",
        "two_independent_humans", "prohibited_until_implemented"
      ]
    },
    "authoritySource": {
      "enum": ["policy", "standing_grant", "one_shot_human", "release_campaign", "dual_human", "none"]
    },
    "decisionStatus": { "enum": ["authorized", "human_approval_required", "denied"] },
    "gateStatus": { "enum": ["pass", "blocked", "unknown"] },
    "verificationPurpose": { "enum": ["initial_decision", "dispatch", "reconcile", "mutation"] },
    "ledgerState": { "enum": ["active", "revoked", "superseded", "unknown"] },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCode" }
    },
    "gateResult": {
      "type": "object",
      "required": ["artifact_version", "gate_id", "consumed_context_sha256", "status", "reason_codes", "messages", "evidence_sha256s", "result_sha256"],
      "properties": {
        "artifact_version": { "const": "gate-result/1.0" },
        "gate_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "consumed_context_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
        "status": { "$ref": "#/$defs/gateStatus" },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" },
        "messages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_sha256s": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/sha256" } },
        "result_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pass" } } },
          "then": { "properties": { "reason_codes": { "maxItems": 0 }, "messages": { "maxItems": 0 } } },
          "else": { "properties": { "reason_codes": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": ["claim_id", "gate_id", "reason_code", "message"],
      "properties": {
        "claim_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "gate_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "reason_code": { "$ref": "artifact-common.schema.json#/$defs/canonicalReasonCode" },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "outputScope": {
      "type": "object",
      "required": ["path_prefix", "artifact_versions"],
      "properties": {
        "path_prefix": { "$ref": "artifact-common.schema.json#/$defs/relativePath" },
        "artifact_versions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "artifact-common.schema.json#/$defs/artifactVersion" }
        }
      },
      "additionalProperties": false
    },
    "authorityScope": {
      "type": "object",
      "required": [
        "workspace_id", "channel_id", "concept_id", "episode_id", "provider_id",
        "model_id", "destination", "cost_minor_units", "currency", "candidate_count",
        "retry_index", "input_artifacts", "allowed_outputs"
      ],
      "properties": {
        "workspace_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "channel_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "concept_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "episode_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
        "provider_id": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/opaqueId" }] },
        "model_id": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/opaqueId" }] },
        "destination": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "cost_minor_units": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "retry_index": { "type": "integer", "minimum": 0 },
        "input_artifacts": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" } },
        "allowed_outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/outputScope" } }
      },
      "additionalProperties": false
    }
  }
}
