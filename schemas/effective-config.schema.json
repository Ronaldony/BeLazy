{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/config/effective-config.schema.json",
  "title": "Effective configuration snapshot",
  "type": "object",
  "required": [
    "artifact_version",
    "created_at",
    "scope",
    "versions",
    "bindings",
    "sources",
    "effective",
    "provenance",
    "constraints",
    "effective_config_sha256"
  ],
  "properties": {
    "artifact_version": {"const": "effective-config/1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "required": ["workspace_id", "channel_profile_id", "concept_profile_id", "episode_id"],
      "properties": {
        "workspace_id": {"$ref": "config-layer.schema.json#/$defs/opaqueId"},
        "channel_profile_id": {"$ref": "config-layer.schema.json#/$defs/opaqueId"},
        "concept_profile_id": {
          "anyOf": [
            {"$ref": "config-layer.schema.json#/$defs/opaqueId"},
            {"type": "null"}
          ]
        },
        "episode_id": {
          "anyOf": [
            {"$ref": "config-layer.schema.json#/$defs/opaqueId"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": [
        "core_distribution",
        "core_contract",
        "rules_version",
        "policy_version",
        "config_contract"
      ],
      "properties": {
        "core_distribution": {"type": "string", "minLength": 1},
        "core_contract": {"$ref": "config-layer.schema.json#/$defs/contractVersion"},
        "rules_version": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "config_contract": {"const": "1.0"}
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": ["core_lock_sha256"],
      "properties": {
        "core_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "source_id", "path", "sha256"],
        "properties": {
          "layer": {
            "enum": [
              "core_defaults",
              "workspace",
              "channel",
              "concept",
              "episode",
              "runtime_override",
              "human_decision"
            ]
          },
          "source_id": {"$ref": "config-layer.schema.json#/$defs/opaqueId"},
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "effective": {"$ref": "config-layer.schema.json#/$defs/effective"},
    "provenance": {
      "type": "object",
      "propertyNames": {"pattern": "^/"},
      "additionalProperties": {
        "type": "object",
        "required": ["winning_layer", "source_id"],
        "properties": {
          "winning_layer": {
            "enum": [
              "core_defaults",
              "workspace",
              "channel",
              "concept",
              "episode",
              "runtime_override",
              "human_decision"
            ]
          },
          "source_id": {"$ref": "config-layer.schema.json#/$defs/opaqueId"}
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "required": ["applied", "rejected_overrides"],
      "properties": {
        "applied": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rejected_overrides": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "effective_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "x-hash-canonicalization": "canonical-json-v1; created_at and effective_config_sha256 excluded",
  "x-artifact-migration": {
    "id_pattern": "^effective-config/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
