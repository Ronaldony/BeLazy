{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/authority/authority-verification-receipt.schema.json",
  "title": "Trusted-ledger current verification and reservation receipt",
  "type": "object",
  "required": [
    "artifact_version", "receipt_id", "receipt_sha256", "purpose",
    "action_request_sha256", "authority_decision_sha256", "gate_context_sha256",
    "risk_assessment_sha256", "authority_source", "ledger_state", "ledger_head_sha256",
    "ledger_entry", "grant_sha256", "principal_ids", "signature_verification_refs",
    "revocation_checked_at", "kill_switch_clear", "reserved_cost_minor_units", "currency",
    "reserved_candidates", "retry_index", "idempotency_key", "workspace_id",
    "workspace_observation_sha256", "adapter_id",
    "service_identity", "evaluated_at", "valid_until"
  ],
  "properties": {
    "artifact_version": { "const": "authority-verification-receipt/1.0" },
    "receipt_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "receipt_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "purpose": { "$ref": "workflow-authority-common.schema.json#/$defs/verificationPurpose" },
    "action_request_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "authority_decision_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/sha256" }] },
    "gate_context_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "risk_assessment_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "authority_source": { "$ref": "workflow-authority-common.schema.json#/$defs/authoritySource" },
    "ledger_state": { "const": "active" },
    "ledger_head_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "ledger_entry": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "grant_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/sha256" }] },
    "principal_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "signature_verification_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" } },
    "revocation_checked_at": { "type": "string", "format": "date-time" },
    "kill_switch_clear": { "const": true },
    "reserved_cost_minor_units": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "reserved_candidates": { "type": "integer", "minimum": 0 },
    "retry_index": { "type": "integer", "minimum": 0 },
    "idempotency_key": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "workspace_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "workspace_observation_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/sha256" }] },
    "adapter_id": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/opaqueId" }] },
    "service_identity": { "oneOf": [{ "type": "null" }, { "$ref": "artifact-common.schema.json#/$defs/opaqueId" }] },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
