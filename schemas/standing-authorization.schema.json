{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/authority/standing-authorization.schema.json",
  "title": "Unverified bounded standing authorization document",
  "type": "object",
  "required": [
    "artifact_version", "authorization_id", "authorization_sha256", "gate_context_sha256",
    "capability_ids", "workspace_ids", "channel_ids", "concept_ids", "episode_ids",
    "provider_ids", "model_ids", "destinations", "max_cost_per_run_minor",
    "max_cost_per_day_minor", "currency", "max_candidates", "max_retries",
    "allowed_risks", "minimum_assurance", "maximum_autonomy", "exact_input_artifacts",
    "allowed_outputs",
    "valid_from", "expires_at", "ledger_record", "signature_verification_refs", "authority_effect"
  ],
  "properties": {
    "artifact_version": { "const": "standing-authorization/1.0" },
    "authorization_id": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" },
    "authorization_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "gate_context_sha256": { "$ref": "artifact-common.schema.json#/$defs/sha256" },
    "capability_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "workspace_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "channel_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "concept_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "episode_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "provider_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "model_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/opaqueId" } },
    "destinations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "max_cost_per_run_minor": { "type": "integer", "minimum": 0 },
    "max_cost_per_day_minor": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "max_candidates": { "type": "integer", "minimum": 0 },
    "max_retries": { "type": "integer", "minimum": 0 },
    "allowed_risks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["R0", "R1", "R2", "R3"] } },
    "minimum_assurance": { "$ref": "workflow-authority-common.schema.json#/$defs/assurance" },
    "maximum_autonomy": { "$ref": "workflow-authority-common.schema.json#/$defs/autonomy" },
    "exact_input_artifacts": { "type": "array", "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" } },
    "allowed_outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "workflow-authority-common.schema.json#/$defs/outputScope" } },
    "valid_from": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "ledger_record": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" },
    "signature_verification_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "artifact-common.schema.json#/$defs/boundArtifact" } },
    "authority_effect": { "const": "none" }
  },
  "additionalProperties": false
}
