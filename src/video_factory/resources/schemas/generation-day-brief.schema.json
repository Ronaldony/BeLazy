{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video-factory.invalid/artifact/generation-day-brief.schema.json",
  "title": "Generation-day approval-wait summary (no auto approval or generation)",
  "type": "object",
  "required": [
    "artifact_version",
    "rules_version",
    "episode_id",
    "generated_at",
    "approval_items",
    "ready_for_generation",
    "automatic_approval_performed",
    "generation_executed"
  ],
  "properties": {
    "artifact_version": {
      "const": "generation-day-brief/1.0"
    },
    "rules_version": {
      "$ref": "artifact-common.schema.json#/$defs/rulesVersion"
    },
    "episode_id": {
      "$ref": "artifact-common.schema.json#/$defs/opaqueId"
    },
    "extensions": {
      "$ref": "artifact-common.schema.json#/$defs/extensions"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "scorecard_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "artifact-common.schema.json#/$defs/pathSha256"
        }
      ]
    },
    "approval_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "state",
          "blockers"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "target_path": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "artifact-common.schema.json#/$defs/relativePath"
              }
            ]
          },
          "target_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_command": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "quota_input": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "artifact-common.schema.json#/$defs/relativePath"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "quota": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "artifact-common.schema.json#/$defs/quotaAmount"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ready_for_generation": {
      "type": "boolean"
    },
    "automatic_approval_performed": {
      "const": false
    },
    "generation_executed": {
      "const": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "x-artifact-migration": {
    "id_pattern": "^generation-day-brief/[1-9][0-9]*-to-[1-9][0-9]*/[1-9][0-9]*$",
    "single_major_step": true,
    "in_place": false,
    "automatic_downgrade": false
  }
}
